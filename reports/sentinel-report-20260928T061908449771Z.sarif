                }
              }
            }
          ]
        },
        {
          "ruleId": "SWC-107",
          "level": "note",
          "message": {
            "text": "External Call To User-Supplied Address\nA call to a user-supplied address is executed.\nAn external message call to an address specified by the caller is executed. Note that the callee account might contain arbitrary code and could re-enter any function within this contract. Reentering the contract in an intermediate state may lead to unexpected behaviour. Make sure that no state modifications are executed after this call and/or reentrancy guards are in place."
          },
          "properties": {
            "sentinelStatus": "candidate",
            "confidence": "unknown",
            "evidence": [
              "mythril:SWC-107: A call to a user-supplied address is executed.\nAn external message call to an address specified by the caller is executed. Note that the callee account might contain arbitrary code and could re-enter any function within this contract. Reentering the contract in an intermediate state may lead to unexpected behaviour. Make sure that no state modifications are executed after this call and/or reentrancy guards are in place."
            ]
