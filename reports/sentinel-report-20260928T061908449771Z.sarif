        {
          "ruleId": "SWC-107",
          "level": "warning",
          "message": {
            "text": "State access after external call\nWrite to persistent state following external call\nThe contract account state is accessed after an external call to a user defined address. To prevent reentrancy issues, consider accessing the state only before the call, especially if the callee is untrusted. Alternatively, a reentrancy lock can be used to prevent untrusted callees from re-entering the contract in an intermediate state."
          },
          "properties": {
            "sentinelStatus": "candidate",
            "confidence": "unknown",
            "evidence": [
